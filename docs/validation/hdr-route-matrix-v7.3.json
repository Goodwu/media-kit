{
  "schema": 1,
  "taskId": "MK-ROUTING-20261011",
  "specification": "HDR v7.3 fixed first-feasible C1-C4",
  "releasePolicy": "All applicable paths require actual path-specific evidence; fallback success cannot accept an earlier candidate; no feature-enable switches.",
  "releaseReady": false,
  "sourceNotes": {
    "dvP5": "Native DV or RPU-based PQ reshape; IPT has no safe C3",
    "dvP81": "Profile 8.1, compatible PQ base; do not conflate profile support with native decoder admission",
    "dvP82": "C3 is an SDR base allowed only for an explicitly SDR display; C2 can generate PQ on an HDR panel",
    "dvP84": "HLG compatibility base, optionally converted HLG-to-PQ",
    "dvP7": "C2 only when EL residual reconstruction is provably unnecessary; native P7 requires actual dual-layer implementation",
    "hdr10": "Static PQ direct; C2/C3/C4 must not duplicate or fabricate conversions",
    "hlg": "HLG direct when declared, otherwise HLG-to-PQ",
    "hdr10Plus": "C1 native and C2 local ST2094-40 mapping are separate required functions; C3 is static PQ",
    "hdrVividPq": "Vivid dynamic mapping with PQ base distinct from Vivid-HLG",
    "hdrVividHlg": "Vivid dynamic mapping with HLG base; baseline HLG-to-PQ is not dynamic mapping",
    "sdr": "Ordinary SDR direct irrespective of HDR display",
    "dvP10": "Unsupported DV over AV1 requires explicit typed precheck block; no SDR disguise",
    "dvUnknown": "Unresolved Dolby Vision signaling must block"
  },
  "requiredAdditionalCases": [
    "sdrDirect",
    "hdrDisplayMissingMustBlock",
    "hdrNoSdrFallback",
    "sdrOnlyToneMap",
    "dvUnknownBlock",
    "requireOutputConflict",
