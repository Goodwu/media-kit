    {
      "id": "PR6-SEMANTIC-P1",
      "severity": "P1",
      "activeProductionImportApproved": false,
      "path": "media_kit_video/lib/src/hdr/hdr_decoder_review.dart",
      "detail": "PR6 moves all completeness checks ahead of observedDecoderEndpoints and native configuration validation. Every incomplete round returns null before recording identity; first complete round records then returns facts and exits gather. Existing cross-round rejection is no longer exercised. Same entry/epoch, stable per-round A/B, known component A/hwdec/MIME with missing pixel then component B with complete facts is accepted by incoming gather. Public map rejects. Same MIME/hwdec final validation does not reconstruct the earlier component.",
      "sourceAnchors": {
        "publicMap": "public lines 241-267",
        "publicConfigBeforeCompleteness": "public lines 274-294",
        "publicExit": "public lines 332-338",
        "sessionSnapshotOnly": "hdr_video_session.dart lines 1128-1134,1195-1225"
      },
