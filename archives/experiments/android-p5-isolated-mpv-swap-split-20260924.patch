@@ -292,9 +310,31 @@ void ra_gl_ctx_swap_buffers(struct ra_swapchain *sw)
 
     while (p->num_vsync_fences >= sw->ctx->vo->opts->swapchain_depth) {
         gl->ClientWaitSync(p->vsync_fences[0], GL_SYNC_FLUSH_COMMANDS_BIT, 1e9);
+#ifdef __ANDROID__
+        if (p5_swap_probe)
+            p5_fences_waited++;
