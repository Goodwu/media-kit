+        void *log_lib = dlopen("liblog.so", RTLD_NOW | RTLD_LOCAL);
+        typedef int (*log_print_fn)(int, const char *, const char *, ...);
+        log_print_fn log_print = log_lib ? dlsym(log_lib, "__android_log_print") : NULL;
+        if (log_print)
+            log_print(6, "P5_SWAP_SPLIT",
