+                      (long long)((p5_egl_end_ns - p5_egl_start_ns) / 1000),
+                      (long long)((p5_fence_end_ns - p5_egl_end_ns) / 1000),
+                      p5_fences_waited, sw->ctx->vo->opts->swapchain_depth);
+        if (log_lib)
+            dlclose(log_lib);
+    }
+#endif
 }
 
