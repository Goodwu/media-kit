+static GL *p5_gpu_timer_gl(struct priv *p)
+{
+    struct ra *ra = p->ra_ctx ? p->ra_ctx->ra : NULL;
+    return ra && ra_is_gl(ra) ? ra_gl_get(ra) : NULL;
