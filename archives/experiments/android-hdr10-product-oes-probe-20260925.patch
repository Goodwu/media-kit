+static void probe_oes_sample(struct priv *p, pl_gpu gpu, struct pl_frame *frame,
+                             struct mp_image *mpi)
+{
+#if defined(__ANDROID__)
+    static int sampled_images;
+    static bool have_last_pts;
+    static double last_pts;
+    char enabled[PROP_VALUE_MAX] = {0};
+    if (sampled_images >= 3 || (have_last_pts && mpi->pts == last_pts) ||
+        __system_property_get("debug.media_kit.oes_sample_probe", enabled) <= 0 ||
+        enabled[0] != '1' || frame->num_planes != 1)
+        return;
+    sampled_images++;
+    have_last_pts = true;
+    last_pts = mpi->pts;
+
+    pl_tex src = frame->planes[0].texture;
+    const enum pl_fmt_caps caps = PL_FMT_CAP_RENDERABLE | PL_FMT_CAP_HOST_READABLE;
+    pl_fmt fmt = pl_find_fmt(gpu, PL_FMT_FLOAT, 4, 16, 16, caps);
+    if (!src || !fmt) {
+        MP_ERR(p, "OES_SAMPLE pts=%.9f unavailable src=%d fmt=%d\n",
+               mpi->pts, !!src, !!fmt);
+        return;
+    }
+
+    pl_tex dst = pl_tex_create(gpu, &(struct pl_tex_params) {
+        .w = 1, .h = 1, .format = fmt,
+        .renderable = true, .host_readable = true,
+    });
+    pl_dispatch dp = pl_dispatch_create(p->pllog, gpu);
+    if (!dst || !dp) {
+        MP_ERR(p, "OES_SAMPLE pts=%.9f setup-failed dst=%d dp=%d fmt=%s\n",
+               mpi->pts, !!dst, !!dp, fmt->name);
+        goto done;
+    }
+
+    int y = src->params.h / 2;
+    for (int i = 0; i < 5; i++) {
+        int x = (int) ((2 * i + 1) * src->params.w / 10);
+        pl_shader sh = pl_dispatch_begin(dp);
+        bool sampled = pl_shader_sample_direct(sh, pl_sample_src(
+            .tex = src,
+            .rect = {x, y, x + 1, y + 1},
+            .new_w = 1, .new_h = 1,
+        ));
+        bool rendered = sampled && pl_dispatch_finish(dp, pl_dispatch_params(
+            .shader = &sh, .target = dst,
+        ));
+        uint16_t rgba[4] = {0};
+        bool read = rendered && pl_tex_download(gpu, pl_tex_transfer_params(
+            .tex = dst, .ptr = rgba,
+        ));
+        MP_ERR(p, "OES_SAMPLE pts=%.9f xy=%d,%d size=%dx%d fmt=%s ok=%d%d%d "
+                  "half=%04x,%04x,%04x,%04x\n",
+               mpi->pts, x, y, src->params.w, src->params.h, fmt->name,
+               sampled, rendered, read, rgba[0], rgba[1], rgba[2], rgba[3]);
+        if (!read)
+            break;
+    }
+
+done:
+    pl_dispatch_destroy(&dp);
+    pl_tex_destroy(gpu, &dst);
+#endif
+}
+
 static bool hwdec_acquire(pl_gpu gpu, struct pl_frame *frame)
 {
     struct mp_image *mpi = frame->user_data;
@@ -602,6 +674,8 @@ static bool hwdec_acquire(pl_gpu gpu, struct pl_frame *frame)
             return false;
     }
 
+    probe_oes_sample(p, gpu, frame, mpi);
+
     return true;
 }
 
