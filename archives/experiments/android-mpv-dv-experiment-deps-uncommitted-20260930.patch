 struct priv {
     struct GL gl;
     EGLDisplay egl_display;
     EGLContext egl_context;
     EGLSurface egl_surface;
+    bool trace_swaps;
+    bool stage_probe;
+    unsigned long long swap_count;
+    unsigned long long swap_failures;
 };
 
+static atomic_ullong stage_swap_in;
+static atomic_ullong stage_swap_out;
+static pthread_once_t swap_watchdog_once = PTHREAD_ONCE_INIT;
+
+static void *swap_watchdog(void *unused)
+{
+    void *liblog = dlopen("liblog.so", RTLD_NOW | RTLD_LOCAL);
+    int (*android_log_write)(int, const char *, const char *) =
+        liblog ? dlsym(liblog, "__android_log_write") : NULL;
+    if (!android_log_write)
+        return NULL;
+    unsigned long long previous_out = 0;
+    unsigned int idle_seconds = 0;
+    for (;;) {
+        sleep(1);
+        unsigned long long in = atomic_load_explicit(&stage_swap_in, memory_order_relaxed);
+        unsigned long long out = atomic_load_explicit(&stage_swap_out, memory_order_relaxed);
+        idle_seconds = out == previous_out ? idle_seconds + 1 : 0;
+        previous_out = out;
+        char message[128];
+        snprintf(message, sizeof(message), "swap_in=%llu swap_out=%llu idle_s=%u",
+                 in, out, idle_seconds);
+        android_log_write(4, "MEDIA_KIT_NATIVE_SWAP", message);
+    }
+}
+
+static void start_swap_watchdog(void)
+{
+    pthread_t thread;
+    if (pthread_create(&thread, NULL, swap_watchdog, NULL) == 0)
+        pthread_detach(thread);
+}
