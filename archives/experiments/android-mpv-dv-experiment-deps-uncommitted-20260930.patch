+                 atomic_load_explicit(&media_kit_send_in, memory_order_relaxed),
+                 atomic_load_explicit(&media_kit_send_out, memory_order_relaxed),
+                 atomic_load_explicit(&media_kit_recv_in, memory_order_relaxed),
+                 atomic_load_explicit(&media_kit_recv_out, memory_order_relaxed),
+                 atomic_load_explicit(&media_kit_decoded, memory_order_relaxed),
+                 atomic_load_explicit(&media_kit_draw_in, memory_order_relaxed),
