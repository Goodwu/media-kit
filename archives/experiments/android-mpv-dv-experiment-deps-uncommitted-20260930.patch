+static void *stage_watchdog(void *unused)
+{
+    void *liblog = dlopen("liblog.so", RTLD_NOW | RTLD_LOCAL);
+    int (*android_log_write)(int, const char *, const char *) =
+        liblog ? dlsym(liblog, "__android_log_write") : NULL;
+    if (!android_log_write)
+        return NULL;
+
+    unsigned long long previous_map = 0;
+    unsigned int idle_seconds = 0;
+    for (;;) {
+        sleep(1);
+        unsigned long long n[ST_COUNT];
+        for (int i = 0; i < ST_COUNT; i++)
+            n[i] = atomic_load_explicit(&stage_counts[i], memory_order_relaxed);
+        int phase = atomic_load_explicit(&last_stage, memory_order_acquire);
+        idle_seconds = n[ST_MAP] == previous_map ? idle_seconds + 1 : 0;
+        previous_map = n[ST_MAP];
