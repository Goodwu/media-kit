+static bool egl_cache_image_in_flight(struct priv *p, EGLImageKHR image)
+{
+    if (p->egl_image == image)
+        return true;
+    for (int i = 0; i < p->retired_count; i++) {
+        if (p->retired[i].egl_image == image)
+            return true;
+    }
+    return false;
+}
