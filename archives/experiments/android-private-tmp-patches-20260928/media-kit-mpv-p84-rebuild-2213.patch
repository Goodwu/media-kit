+MPV_DEFINE_SYM_PTR(mpv_lavc_set_java_vm)
+#define mpv_lavc_set_java_vm pfn_mpv_lavc_set_java_vm
 MPV_DEFINE_SYM_PTR(mpv_set_wakeup_callback)
 #define mpv_set_wakeup_callback pfn_mpv_set_wakeup_callback
