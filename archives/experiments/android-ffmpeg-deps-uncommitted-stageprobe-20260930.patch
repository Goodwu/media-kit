+
+static int p5_probe_start_code(const uint8_t *data, int size, int pos,
+                               int *header)
+{
+    for (int i = pos; i + 3 <= size; i++) {
+        if (data[i] || data[i + 1] ||
+            (data[i + 2] != 1 &&
+             !(i + 3 < size && !data[i + 2] && data[i + 3] == 1)))
+            continue;
+        *header = i + (data[i + 2] == 1 ? 3 : 4);
+        return i;
+    }
+    return -1;
+}
+
+static void p5_probe_nal(MediaCodecH264DecContext *s,
+                         const uint8_t *data, int size)
+{
+    uint32_t hash;
+
+    if (size < 2) {
+        s->p5_probe.next.parse_error = 1;
+        return;
+    }
+    if (((data[0] >> 1) & 0x3f) != 62)
+        return;
+
+    s->p5_probe.next.rpu_count++;
+    /* A Dolby Vision RPU has layer id 0 and temporal_id_plus1 1. */
+    if (((data[0] & 1) << 5 | data[1] >> 3) != 0 || (data[1] & 7) != 1)
+        s->p5_probe.next.parse_error = 1;
+    s->p5_probe.next.rpu_size += size - 2;
+    hash = s->p5_probe.next.rpu_hash ? s->p5_probe.next.rpu_hash : 2166136261U;
+    for (int i = 2; i < size; i++)
+        hash = (hash ^ data[i]) * 16777619U;
+    s->p5_probe.next.rpu_hash = hash;
+}
+
+static void p5_probe_parse_metadata(AVCodecContext *avctx, AVPacket *pkt,
+                                    int length_size)
+{
+    MediaCodecH264DecContext *s = avctx->priv_data;
+    H2645Packet split = { 0 };
+    size_t sd_size = 0;
+    const uint8_t *sd;
+    int flags = H2645_FLAG_SMALL_PADDING;
+    int ret;
+
+    if (s->p5_probe.next.rpu_count != 1 || s->p5_probe.next.parse_error)
+        return;
+    sd = av_packet_get_side_data(pkt, AV_PKT_DATA_DOVI_CONF, &sd_size);
+    if (sd && sd_size >= sizeof(s->p5_probe.dovi.cfg))
+        memcpy(&s->p5_probe.dovi.cfg, sd, sizeof(s->p5_probe.dovi.cfg));
+    if (length_size)
+        flags |= H2645_FLAG_IS_NALFF;
+    ret = ff_h2645_packet_split(&split, pkt->data, pkt->size, avctx,
+                                length_size, AV_CODEC_ID_HEVC, flags);
+    if (ret < 0) {
+        s->p5_probe.next.parse_error = 1;
+        goto done;
+    }
+    for (int i = 0; i < split.nb_nals; i++) {
+        H2645NAL *nal = &split.nals[i];
+        if (nal->type != 62)
+            continue;
+        if (nal->size <= 2 || nal->raw_size <= 2 ||
+            nal->nuh_layer_id || nal->temporal_id) {
+            s->p5_probe.next.parse_error = 1;
+            break;
+        }
+        ret = ff_dovi_rpu_parse(&s->p5_probe.dovi, nal->data + 2,
+                                nal->size - 2, avctx->err_recognition);
+        if (ret < 0) {
+            s->p5_probe.next.parse_error = 1;
+            break;
+        }
+        s->p5_probe.next.metadata_size = ff_dovi_get_metadata(
+            &s->p5_probe.dovi, &s->p5_probe.next.metadata);
+        if (s->p5_probe.next.metadata_size <= 0) {
+            s->p5_probe.next.parse_error = 1;
+            break;
+        }
+        s->p5_probe.next.raw_rpu_size = nal->raw_size - 2;
+        s->p5_probe.next.raw_rpu = av_memdup(nal->raw_data + 2,
+                                              s->p5_probe.next.raw_rpu_size);
+        if (!s->p5_probe.next.raw_rpu)
+            s->p5_probe.next.parse_error = 1;
+        break;
+    }
+    if (!s->p5_probe.next.metadata)
+        s->p5_probe.next.parse_error = 1;
+done:
+    if (s->p5_probe.next.parse_error)
+        p5_probe_clear_entry(&s->p5_probe.next);
+    ff_h2645_packet_uninit(&split);
+}
+
+static void p5_probe_packet(AVCodecContext *avctx, AVPacket *pkt)
+{
+    MediaCodecH264DecContext *s = avctx->priv_data;
+    int header, start, pos, length_size = 0;
+
+    if (!s->p5_probe.enabled)
+        return;
+    p5_probe_clear_entry(&s->p5_probe.next);
+    memset(&s->p5_probe.next, 0, sizeof(s->p5_probe.next));
+    s->p5_probe.pending = 1;
+    s->p5_probe.next.epoch = s->p5_probe.epoch;
+    s->p5_probe.next.missing_pts = pkt->pts == AV_NOPTS_VALUE;
+    s->p5_probe.next.pts_us = pkt->pts;
+    if (!s->p5_probe.next.missing_pts && pkt->pts &&
+        avctx->pkt_timebase.num && avctx->pkt_timebase.den)
+        s->p5_probe.next.pts_us = av_rescale_q(pkt->pts, avctx->pkt_timebase,
+                                                AV_TIME_BASE_Q);
+    if (!pkt->data || pkt->size <= 0) {
+        s->p5_probe.next.parse_error = 1;
+        return;
+    }
+
+    start = p5_probe_start_code(pkt->data, pkt->size, 0, &header);
+    if (start >= 0 && start <= 3) {
+        while (start >= 0) {
+            int next_header, next = p5_probe_start_code(pkt->data, pkt->size,
+                                                         header, &next_header);
+            p5_probe_nal(s, pkt->data + header,
+                         (next < 0 ? pkt->size : next) - header);
+            start = next;
+            if (next >= 0)
+                header = next_header;
+        }
+    } else {
+        /* hvcC stores lengthSizeMinusOne in the low two bits of byte 21. */
+        if (avctx->extradata_size > 21 && avctx->extradata[0] == 1)
+            length_size = (avctx->extradata[21] & 3) + 1;
+        if (!length_size) {
+            s->p5_probe.next.parse_error = 1;
+            return;
+        }
+        for (pos = 0; pos < pkt->size;) {
+            unsigned len = 0;
+            if (pkt->size - pos < length_size) {
+                s->p5_probe.next.parse_error = 1;
+                break;
+            }
+            for (int i = 0; i < length_size; i++)
+                len = (len << 8) | pkt->data[pos++];
+            if (!len || len > pkt->size - pos) {
+                s->p5_probe.next.parse_error = 1;
+                break;
+            }
+            p5_probe_nal(s, pkt->data + pos, len);
+            pos += len;
+        }
+    }
+    p5_probe_parse_metadata(avctx, pkt, length_size);
+}
+
+static void p5_probe_commit(AVCodecContext *avctx)
+{
+    MediaCodecH264DecContext *s = avctx->priv_data;
+    P5ProbeEntry *entry;
+    unsigned seq, slot;
+    const char *status = "OK";
+
+    if (!s->p5_probe.enabled || !s->p5_probe.pending)
+        return;
+    s->p5_probe.pending = 0;
+    seq = s->p5_probe.inputs++;
+    slot = seq % FF_ARRAY_ELEMS(s->p5_probe.entries);
+    entry = &s->p5_probe.entries[slot];
+    if (entry->valid && !entry->consumed) {
+        s->p5_probe.discarded++;
+        s->p5_probe.errors++;
+        if (s->p5_probe.discarded <= 20 ||
+            s->p5_probe.discarded % 1000 == 0)
+            av_log(avctx, AV_LOG_ERROR,
+                   "MEDIA_KIT_P5_RPU stale eviction epoch=%u input_seq=%u held_seq=%u discarded=%u\n",
+                   s->p5_probe.epoch, seq, entry->seq,
+                   s->p5_probe.discarded);
+    }
+    for (unsigned j = 0; j < FF_ARRAY_ELEMS(s->p5_probe.entries); j++) {
+        P5ProbeEntry *old = &s->p5_probe.entries[j];
+        if (old->valid && old->epoch == s->p5_probe.epoch &&
+            !old->missing_pts && !s->p5_probe.next.missing_pts &&
+            old->pts_us == s->p5_probe.next.pts_us)
+            s->p5_probe.next.duplicate_pts = 1;
+    }
+    p5_probe_clear_entry(entry);
+    *entry = s->p5_probe.next;
+    entry->seq = seq;
+    entry->valid = 1;
+    s->p5_probe.next.metadata = NULL;
+    s->p5_probe.next.raw_rpu = NULL;
+    if (entry->missing_pts)
+        status = "MISSING_INPUT_PTS";
+    else if (entry->parse_error)
+        status = "PARSE_ERROR";
+    else if (entry->rpu_count != 1)
+        status = entry->rpu_count ? "MULTIPLE_RPU" : "MISSING_RPU";
+    else if (entry->duplicate_pts)
+        status = "DUPLICATE_INPUT_PTS";
+    if (strcmp(status, "OK"))
+        s->p5_probe.errors++;
+    if (seq < 320 || (seq + 1) % 1000 == 0 ||
+        (strcmp(status, "OK") && s->p5_probe.errors <= 20))
+        av_log(avctx, AV_LOG_WARNING,
+               "MEDIA_KIT_P5_RPU input epoch=%u seq=%u pts_us=%"PRId64
+               " rpu=%u bytes=%u hash=%08x meta_bytes=%d profile=%u residual=%d status=%s\n",
+               s->p5_probe.epoch, seq, entry->pts_us,
+               entry->rpu_count, entry->rpu_size, entry->rpu_hash,
+               entry->metadata_size, s->p5_probe.dovi.cfg.dv_profile,
+               entry->metadata ?
+                   av_dovi_get_header(entry->metadata)->disable_residual_flag : -1,
+               status);
+}
+
+static void p5_probe_output(AVCodecContext *avctx, AVFrame *frame)
+{
+    MediaCodecH264DecContext *s = avctx->priv_data;
+    P5ProbeEntry *entry = NULL;
+    int64_t pts_us;
+    int found = -1, count = 0, attached = 0, metadata_size = 0;
+    const char *status;
+
+    if (!s->p5_probe.enabled)
+        return;
+    if (frame->format == AV_PIX_FMT_MEDIACODEC && frame->data[3])
+        pts_us = ((MediaCodecBuffer *)frame->data[3])->pts;
+    else if (frame->pts != AV_NOPTS_VALUE && avctx->pkt_timebase.num &&
+             avctx->pkt_timebase.den)
+        pts_us = av_rescale_q(frame->pts, avctx->pkt_timebase, AV_TIME_BASE_Q);
+    else
+        pts_us = AV_NOPTS_VALUE;
+
+    s->p5_probe.outputs++;
+    for (unsigned i = 0; i < FF_ARRAY_ELEMS(s->p5_probe.entries); i++) {
+        if (s->p5_probe.entries[i].valid &&
+            s->p5_probe.entries[i].epoch == s->p5_probe.epoch &&
+            !s->p5_probe.entries[i].missing_pts && pts_us != AV_NOPTS_VALUE &&
+            s->p5_probe.entries[i].pts_us == pts_us) {
+            found = i;
+            count++;
+        }
+    }
+    if (pts_us == AV_NOPTS_VALUE)
+        status = "MISSING_OUTPUT_PTS";
+    else if (count > 1)
+        status = "DUPLICATE_INPUT_PTS";
+    else if (count == 0)
+        status = "UNMATCHED_OUTPUT_PTS";
+    else if (s->p5_probe.entries[found].consumed)
+        status = "DUPLICATE_OUTPUT_PTS";
+    else if (s->p5_probe.entries[found].duplicate_pts)
+        status = "DUPLICATE_INPUT_PTS";
+    else if (s->p5_probe.entries[found].parse_error)
+        status = "PARSE_ERROR";
+    else if (s->p5_probe.entries[found].rpu_count != 1)
+        status = s->p5_probe.entries[found].rpu_count ? "MULTIPLE_RPU" : "MISSING_RPU";
+    else
+        status = "MATCH";
+
+    if (count > 1) {
+        for (unsigned i = 0; i < FF_ARRAY_ELEMS(s->p5_probe.entries); i++) {
+            P5ProbeEntry *ambiguous = &s->p5_probe.entries[i];
+            if (ambiguous->valid && ambiguous->epoch == s->p5_probe.epoch &&
+                !ambiguous->missing_pts && ambiguous->pts_us == pts_us) {
+                ambiguous->consumed = 1;
+                p5_probe_clear_entry(ambiguous);
+            }
+        }
+    }
+    if (count == 1 && !s->p5_probe.entries[found].consumed) {
+        AVFrameSideData *meta_sd, *raw_sd;
+        entry = &s->p5_probe.entries[found];
+        metadata_size = entry->metadata_size;
+        if (s->p5_probe.attach && !strcmp(status, "MATCH")) {
+            if (!entry->metadata || !entry->raw_rpu) {
+                status = "MISSING_PARSED_METADATA";
+            } else if (av_frame_get_side_data(frame, AV_FRAME_DATA_DOVI_METADATA) ||
+                       av_frame_get_side_data(frame, AV_FRAME_DATA_DOVI_RPU_BUFFER)) {
+                status = "EXISTING_DOVI_SIDE_DATA";
+            } else {
+                meta_sd = av_frame_new_side_data(frame, AV_FRAME_DATA_DOVI_METADATA,
+                                                 entry->metadata_size);
+                raw_sd = meta_sd ? av_frame_new_side_data(frame, AV_FRAME_DATA_DOVI_RPU_BUFFER,
+                                                          entry->raw_rpu_size) : NULL;
+                if (!meta_sd || !raw_sd) {
+                    if (meta_sd)
+                        av_frame_remove_side_data(frame, AV_FRAME_DATA_DOVI_METADATA);
+                    status = "ATTACH_ERROR";
+                } else {
+                    memcpy(meta_sd->data, entry->metadata, entry->metadata_size);
+                    memcpy(raw_sd->data, entry->raw_rpu, entry->raw_rpu_size);
+                    attached = 1;
+                }
+            }
+        }
+        entry->consumed = 1;
+        p5_probe_clear_entry(entry);
+    }
+    if (!strcmp(status, "MATCH"))
+        s->p5_probe.matched++;
+    if (strcmp(status, "MATCH"))
+        s->p5_probe.errors++;
+    if (s->p5_probe.outputs <= 250 || s->p5_probe.outputs % 1000 == 0 ||
+        (strcmp(status, "MATCH") && s->p5_probe.errors <= 20))
+        av_log(avctx, AV_LOG_WARNING,
+               "MEDIA_KIT_P5_RPU output epoch=%u seq=%u pts_us=%"PRId64
+               " input_seq=%d meta_bytes=%d attached=%d status=%s\n", s->p5_probe.epoch,
+               s->p5_probe.outputs - 1, pts_us,
+               count == 1 ? (int)s->p5_probe.entries[found].seq : -1,
+               metadata_size, attached, status);
+}
+
+static int p5_probe_receive(AVCodecContext *avctx, AVFrame *frame, bool wait)
+{
+    MediaCodecH264DecContext *s = avctx->priv_data;
+    int ret = ff_mediacodec_dec_receive(avctx, s->ctx, frame, wait);
+    if (!ret)
+        p5_probe_output(avctx, frame);
+    return ret;
+}
+
+static void p5_probe_flush(AVCodecContext *avctx)
+{
+    MediaCodecH264DecContext *s = avctx->priv_data;
+    if (!s->p5_probe.enabled)
+        return;
+    for (unsigned i = 0; i < FF_ARRAY_ELEMS(s->p5_probe.entries); i++) {
+        if (s->p5_probe.entries[i].valid &&
+            s->p5_probe.entries[i].epoch == s->p5_probe.epoch &&
+            !s->p5_probe.entries[i].consumed)
+            s->p5_probe.discarded++;
+        p5_probe_clear_entry(&s->p5_probe.entries[i]);
+        s->p5_probe.entries[i].valid = 0;
+    }
+    av_log(avctx, AV_LOG_WARNING,
+           "MEDIA_KIT_P5_RPU flush epoch=%u next_epoch=%u discarded=%u\n",
+           s->p5_probe.epoch, s->p5_probe.epoch + 1, s->p5_probe.discarded);
+    p5_probe_clear_entry(&s->p5_probe.next);
+    s->p5_probe.pending = 0;
+    ff_dovi_ctx_flush(&s->p5_probe.dovi);
+    s->p5_probe.epoch++;
+}
+
 static av_cold int mediacodec_decode_close(AVCodecContext *avctx)
 {
     MediaCodecH264DecContext *s = avctx->priv_data;
+    unsigned unconsumed = 0;
+
+    if (s->p5_probe.enabled) {
+        for (unsigned i = 0; i < FF_ARRAY_ELEMS(s->p5_probe.entries); i++)
+            if (s->p5_probe.entries[i].valid &&
+                !s->p5_probe.entries[i].consumed)
+                unconsumed++;
+        av_log(avctx, AV_LOG_WARNING,
+               "MEDIA_KIT_P5_RPU summary inputs=%u outputs=%u matched=%u errors=%u discarded=%u unconsumed=%u epoch=%u\n",
+               s->p5_probe.inputs, s->p5_probe.outputs, s->p5_probe.matched,
+               s->p5_probe.errors, s->p5_probe.discarded, unconsumed,
+               s->p5_probe.epoch);
+        for (unsigned i = 0; i < FF_ARRAY_ELEMS(s->p5_probe.entries); i++)
+            p5_probe_clear_entry(&s->p5_probe.entries[i]);
+        p5_probe_clear_entry(&s->p5_probe.next);
